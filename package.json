{
  "name": "engram",
  "version": "0.1.0",
  "description": "A cognitive memory system for AI agents — memories that decay, consolidate, and associate like a human brain",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "bin": {
    "engram": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "cli": "tsx src/cli.ts",
    "agent": "tsx src/run-agent.ts",
    "server": "tsx src/server.ts",
    "benchmark": "tsx benchmark/run-cli.ts",
    "benchmark:adaptive": "tsx benchmark/adaptive-cli.ts",
    "benchmark:longmem": "tsx benchmark/longmemeval-cli.ts",
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:project-memory": "npm test --workspace @engram/project-memory",
    "test:all": "npm test && npm run test:project-memory",
    "project-memory:migrate": "npm run migrate --workspace @engram/project-memory",
    "project-memory:seed": "npm run seed --workspace @engram/project-memory",
    "project-memory:ui": "npm run ui --workspace @engram/project-memory"
  },
  "keywords": [
    "ai",
    "memory",
    "agent",
    "cognitive",
    "decay",
    "spaced-repetition",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
