{
  "name": "engram",
  "version": "0.1.0",
  "description": "A cognitive memory system for AI agents — memories that decay, consolidate, and associate like a human brain",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "engram": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "cli": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "benchmark": "tsx benchmark/run-cli.ts",
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai",
    "memory",
    "agent",
    "cognitive",
    "decay",
    "spaced-repetition",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
