# Sample environment variables for the project-memory prototype.
# Copy to a local .env (not tracked/committed) or export directly in your shell.
#
# Postgres connection string:
DATABASE_URL=postgres:///project_memory_proto
#
# Real extraction/embedding calls activate automatically once these are set as
# real environment variables. Never commit real key values.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
